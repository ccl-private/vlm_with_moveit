<mujoco model="vision_moveit_unified_panda_cup">
  <!-- Panda MJCF 与其网格全部位于本实验目录。 -->
  <include file="panda.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <statistic center="0.35 0 0.45" extent="1.8"/>
  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.25 0.25 0.25" specular="0.1 0.1 0.1"/>
    <rgba haze="0.12 0.16 0.20 1"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.18 0.22 0.26" rgb2="0.10 0.12 0.15" width="512" height="512"/>
    <material name="floor" texture="grid" texrepeat="4 4" reflectance="0.08"/>
    <material name="table_top" rgba="0.47 0.29 0.16 1"/>
    <material name="tray_material" rgba="0.90 0.72 0.16 1"/>
    <material name="cup_red" rgba="0.86 0.08 0.08 1"/>
    <material name="cup_green" rgba="0.06 0.64 0.22 1"/>
    <material name="cup_blue" rgba="0.08 0.29 0.85 1"/>
    <!-- 颜色是场景实例属性；它不写入正方体 CAD 网格。 -->
    <material name="cube_purple" rgba="0.60 0.08 0.78 1"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0.4 -0.5 2.2" dir="0.1 0.2 -1" diffuse="0.9 0.9 0.9"/>
    <light name="fill_light" pos="-1.0 0.8 1.4" dir="0.8 -0.4 -0.8" diffuse="0.35 0.4 0.5"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="floor" friction="1 0.005 0.0001"/>

    <body name="table" pos="0.45 0 0.36">
      <geom name="table_top" type="box" size="0.55 0.48 0.035" material="table_top" friction="1 0.005 0.0001"/>
      <geom name="table_leg_left_front" type="box" pos="0.43 -0.36 -0.32" size="0.04 0.04 0.32" material="table_top"/>
      <geom name="table_leg_right_front" type="box" pos="-0.43 -0.36 -0.32" size="0.04 0.04 0.32" material="table_top"/>
      <geom name="table_leg_left_back" type="box" pos="0.43 0.36 -0.32" size="0.04 0.04 0.32" material="table_top"/>
      <geom name="table_leg_right_back" type="box" pos="-0.43 0.36 -0.32" size="0.04 0.04 0.32" material="table_top"/>
    </body>

    <body name="red_cup" pos="0.48 -0.16 0.465">
      <freejoint name="red_cup_freejoint"/>
      <geom name="red_cup_geom" type="cylinder" size="0.038 0.07" material="cup_red" mass="0.12" friction="1.2 0.01 0.001"/>
    </body>
    <body name="green_cup" pos="0.34 0.06 0.465">
      <freejoint name="green_cup_freejoint"/>
      <geom name="green_cup_geom" type="cylinder" size="0.038 0.07" material="cup_green" mass="0.12" friction="1.2 0.01 0.001"/>
    </body>
    <body name="blue_cup" pos="0.30 -0.24 0.465">
      <freejoint name="blue_cup_freejoint"/>
      <geom name="blue_cup_geom" type="cylinder" size="0.038 0.07" material="cup_blue" mass="0.12" friction="1.2 0.01 0.001"/>
    </body>
    <!-- 位于 Panda 抬升姿态的已验证可达区，并与绿杯、托盘保持分离。 -->
    <body name="purple_cube" pos="0.35 -0.08 0.43">
      <freejoint name="purple_cube_freejoint"/>
      <geom name="purple_cube_geom" type="box" size="0.035 0.035 0.035" material="cube_purple" mass="0.12" friction="1.2 0.01 0.001"/>
    </body>

    <!-- 托盘位于 Panda 下向抓取姿态的可达区；其精确位置同时登记在对象目录中。 -->
    <body name="tray" pos="0.52 0.25 0.45">
      <geom name="tray_base" type="box" size="0.13 0.11 0.012" material="tray_material"/>
      <geom name="tray_front" type="box" pos="0 -0.10 0.035" size="0.13 0.012 0.035" material="tray_material"/>
      <geom name="tray_back" type="box" pos="0 0.10 0.035" size="0.13 0.012 0.035" material="tray_material"/>
      <geom name="tray_left" type="box" pos="-0.12 0 0.035" size="0.012 0.10 0.035" material="tray_material"/>
      <geom name="tray_right" type="box" pos="0.12 0 0.035" size="0.012 0.10 0.035" material="tray_material"/>
      <site name="tray_drop_zone" pos="0 0 0.04" size="0.08" rgba="0.95 0.8 0.1 0.35"/>
    </body>

    <camera name="camera_global" mode="targetbody" target="table" pos="1.55 -1.35 1.35" fovy="48"/>
    <camera name="camera_fixed" mode="targetbody" target="table" pos="0.35 -1.18 1.35" fovy="52"/>
  </worldbody>

</mujoco>
