<mujoco model="vision_moveit_unified_panda_objects">
  <!-- Panda MJCF 与其网格全部位于本实验目录。 -->
  <include file="panda.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <statistic center="0.35 0 0.45" extent="1.8"/>
  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.25 0.25 0.25" specular="0.1 0.1 0.1"/>
    <rgba haze="0.12 0.16 0.20 1"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.18 0.22 0.26" rgb2="0.10 0.12 0.15" width="512" height="512"/>
    <material name="floor" texture="grid" texrepeat="4 4" reflectance="0.08"/>
    <material name="table_top" rgba="0.47 0.29 0.16 1"/>
    <!-- 托盘改为蓝青色，避免与黄色马克杯共享基线颜色分割掩码。 -->
    <material name="tray_material" rgba="0.10 0.42 0.58 1"/>
    <material name="cylinder_red" rgba="0.86 0.08 0.08 1"/>
    <material name="cylinder_green" rgba="0.06 0.64 0.22 1"/>
    <material name="cylinder_blue" rgba="0.08 0.29 0.85 1"/>
    <!-- 颜色是场景实例属性；它不写入正方体 CAD 网格。 -->
    <material name="cube_purple" rgba="0.60 0.08 0.78 1"/>
    <material name="block_magenta" rgba="0.88 0.05 0.72 1"/>
    <material name="mug_yellow" rgba="0.92 0.62 0.06 1" emission="0.35"/>
    <!-- panda.xml 设置了 meshdir=assets，故此路径相对 panda_mjcf/assets 解析。 -->
    <mesh name="mug_handle_visual_mesh" file="../../object_models/mug_with_handle_v1.obj"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0.4 -0.5 2.2" dir="0.1 0.2 -1" diffuse="0.9 0.9 0.9"/>
    <light name="fill_light" pos="-1.0 0.8 1.4" dir="0.8 -0.4 -0.8" diffuse="0.35 0.4 0.5"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="floor" friction="1 0.005 0.0001"/>

    <body name="table" pos="0.45 0 0.36">
      <geom name="table_top" type="box" size="0.55 0.48 0.035" material="table_top" friction="1 0.005 0.0001"/>
      <geom name="table_leg_left_front" type="box" pos="0.43 -0.36 -0.32" size="0.04 0.04 0.32" material="table_top"/>
      <geom name="table_leg_right_front" type="box" pos="-0.43 -0.36 -0.32" size="0.04 0.04 0.32" material="table_top"/>
      <geom name="table_leg_left_back" type="box" pos="0.43 0.36 -0.32" size="0.04 0.04 0.32" material="table_top"/>
      <geom name="table_leg_right_back" type="box" pos="-0.43 0.36 -0.32" size="0.04 0.04 0.32" material="table_top"/>
    </body>

    <body name="red_cylinder" pos="0.30 0.30 0.465">
      <freejoint name="red_cylinder_freejoint"/>
      <geom name="red_cylinder_geom" type="cylinder" size="0.038 0.07" material="cylinder_red" mass="0.12" friction="1.2 0.01 0.001"/>
    </body>
    <!-- 与桌面托盘外缘保留净空，避免托盘落桌后在初始物理步挤压该圆柱。 -->
    <body name="green_cylinder" pos="0.22 0.08 0.465">
      <freejoint name="green_cylinder_freejoint"/>
      <geom name="green_cylinder_geom" type="cylinder" size="0.038 0.07" material="cylinder_green" mass="0.12" friction="1.2 0.01 0.001"/>
    </body>
    <body name="blue_cylinder" pos="0.30 -0.24 0.465">
      <freejoint name="blue_cylinder_freejoint"/>
      <geom name="blue_cylinder_geom" type="cylinder" size="0.038 0.07" material="cylinder_blue" mass="0.12" friction="1.2 0.01 0.001"/>
    </body>
    <!-- 位于 Panda 抬升姿态的已验证可达区，并与绿杯、托盘保持分离。 -->
    <body name="purple_cube" pos="0.35 -0.08 0.43">
      <freejoint name="purple_cube_freejoint"/>
      <geom name="purple_cube_geom" type="box" size="0.035 0.035 0.035" material="cube_purple" mass="0.12" friction="1.2 0.01 0.001"/>
    </body>
    <!-- 位于固定相机前景，避免被杯子遮挡，并留在 0.55 m 工作空间半径内。 -->
    <body name="magenta_block" pos="0.42 -0.28 0.425" quat="0.962425 0 0 0.271547">
      <freejoint name="magenta_block_freejoint"/>
      <geom name="magenta_block_geom" type="box" size="0.070 0.0275 0.030" material="block_magenta" mass="0.12" friction="1.2 0.01 0.001"/>
    </body>
    <!-- 杯体以 MuJoCo 的 w,x,y,z 四元数绕 Z 旋转 180°，把手朝固定相机/机械臂一侧。
         杯身半高为 50 mm，故中心 z=0.445，
         其碰撞底面恰好落在桌面上表面 z=0.395。 -->
    <body name="yellow_mug" pos="0.45 -0.12 0.445" quat="0 0 0 1">
      <freejoint name="yellow_mug_freejoint"/>
      <geom name="yellow_mug_visual" type="mesh" mesh="mug_handle_visual_mesh" material="mug_yellow" contype="0" conaffinity="0" group="2"/>
      <!-- 杯身和把手分开采用稳定的凸碰撞近似；外侧竖杆采用平面接触块，
           与 CAD 标注的 +Y/-Y 成对夹持面一致，防止薄圆杆在单指初触时滚出夹爪。 -->
      <!-- 碰撞几何与视觉网格同为杯身 ±50 mm、把手外竖条 y=68…80 mm。
           接触边界外扩 1 mm：在视觉网格相交前开始受力，且保持原有稳定求解。 -->
      <geom name="yellow_mug_body_collision" type="cylinder" size="0.033 0.050" mass="0.50" friction="5.0 0.01 0.001" margin="0.001" solref="0.002 1" solimp="0.98 0.99 0.0001"/>
      <geom name="yellow_mug_handle_outer_collision" type="box" pos="0 0.074 0" size="0.006 0.006 0.028" mass="0.001" friction="1.2 0.01 0.001" margin="0.001"/>
      <geom name="yellow_mug_handle_upper_collision" type="capsule" fromto="0 0.033 0.034 0 0.074 0.028" size="0.006" mass="0.001" friction="1.2 0.01 0.001" margin="0.001"/>
      <geom name="yellow_mug_handle_lower_collision" type="capsule" fromto="0 0.033 -0.034 0 0.074 -0.028" size="0.006" mass="0.001" friction="1.2 0.01 0.001" margin="0.001"/>
    </body>

    <!-- 托盘底板半厚为 12 mm，中心 z=0.407，使底板直接置于桌面 z=0.395。 -->
    <body name="tray" pos="0.48 0.18 0.407">
      <geom name="tray_base" type="box" size="0.13 0.11 0.012" material="tray_material"/>
      <geom name="tray_front" type="box" pos="0 -0.10 0.035" size="0.13 0.012 0.035" material="tray_material"/>
      <geom name="tray_back" type="box" pos="0 0.10 0.035" size="0.13 0.012 0.035" material="tray_material"/>
      <geom name="tray_left" type="box" pos="-0.12 0 0.035" size="0.012 0.10 0.035" material="tray_material"/>
      <geom name="tray_right" type="box" pos="0.12 0 0.035" size="0.012 0.10 0.035" material="tray_material"/>
      <site name="tray_drop_zone" pos="0 0 0.04" size="0.08" rgba="0.95 0.8 0.1 0.35"/>
    </body>

    <camera name="camera_global" mode="targetbody" target="table" pos="1.55 -1.35 1.35" fovy="48"/>
    <!-- 固定相机侧向观察把手，避免把手与杯身沿视线重合。 -->
    <!-- 高位右前方固定 RGB-D 相机，避开 Panda 前臂对杯把手的遮挡。 -->
    <camera name="camera_fixed" mode="targetbody" target="table" pos="1.10 -0.85 1.65" fovy="50"/>
  </worldbody>

  <!-- 仅在控制器确认左右指尖都接触后运行时激活；初始均不参与约束。 -->
  <equality>
    <weld name="grasp_red_cylinder" body1="hand" body2="red_cylinder" active="false" solref="0.05 1" solimp="0.90 0.98 0.001"/>
    <weld name="grasp_green_cylinder" body1="hand" body2="green_cylinder" active="false" solref="0.05 1" solimp="0.90 0.98 0.001"/>
    <weld name="grasp_blue_cylinder" body1="hand" body2="blue_cylinder" active="false" solref="0.05 1" solimp="0.90 0.98 0.001"/>
    <weld name="grasp_purple_cube" body1="hand" body2="purple_cube" active="false" solref="0.05 1" solimp="0.90 0.98 0.001"/>
    <weld name="grasp_magenta_block" body1="hand" body2="magenta_block" active="false" solref="0.05 1" solimp="0.90 0.98 0.001"/>
    <weld name="grasp_yellow_mug" body1="hand" body2="yellow_mug" active="false" solref="0.05 1" solimp="0.90 0.98 0.001"/>
    <!-- 仅用于视觉与预抓取规划期间锁住长方体；最终接近前解除，避免目标在重力下漂移。 -->
    <weld name="magenta_block_rest" body1="table" body2="magenta_block" active="true" solref="0.01 1" solimp="0.95 0.99 0.0001"/>
    <!-- 仅用于场景静置：视觉帧、MoveIt 预抓取规划期间锁住桌面上的杯子；接近前立即解除。 -->
    <weld name="yellow_mug_rest" body1="table" body2="yellow_mug" active="true" solref="0.01 1" solimp="0.95 0.99 0.0001"/>
  </equality>

</mujoco>
